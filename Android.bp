//
// OplusRefreshRate — vendor 分区版 (vendor 化第一步)
// 与旧 system_ext 版 (PJA110-RefreshRateService) 二选一, 不要同时装入 ROM。
//
// SPDX-License-Identifier: Apache-2.0
//

android_app {
    name: "OplusRefreshRateVendor",

    srcs: [
        "app/src/main/java/**/*.java",
        "service/src/main/java/**/*.java",
    ],
    resource_dirs: ["app/src/main/res"],
    asset_dirs: ["app/src/main/assets"],
    manifest: "service/src/main/AndroidManifest.xml",

    certificate: "platform",
    privileged: true,
    vendor: true,
    // 直接使用 android.os.ServiceManager 等 @hide API, 必须编进平台
    // (vendor 分区 + 空 sdk_version 必须配 platform_apis: true)
    platform_apis: true,
    // vendor priv-app 需要私有平台 API 时再改 use_embedded_native_libs 等

    static_libs: [
        "androidx.preference_preference",
    ],

    optimize: {
        enabled: false,
    },

    // A17 soong 无 lint.check_all_warnings 属性, lint 配置移除

    min_sdk_version: "34",
    target_sdk_version: "35",

    owner: "oplus",
}
