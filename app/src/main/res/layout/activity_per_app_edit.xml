<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/edit_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_mode_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_mode_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/mode_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_mode_auto"
                android:checked="true" />

            <RadioButton
                android:id="@+id/mode_60"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_mode_60" />

            <RadioButton
                android:id="@+id/mode_90"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_mode_90" />

            <RadioButton
                android:id="@+id/mode_120"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_mode_120" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_memc_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_memc_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/memc_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/memc_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_memc_default"
                android:checked="true" />

            <RadioButton
                android:id="@+id/memc_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_memc_force_on" />

            <RadioButton
                android:id="@+id/memc_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/per_app_memc_force_off" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_params_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/per_app_params_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/params_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:typeface="monospace"
            android:inputType="textMultiLine|textNoSuggestions"
            android:hint="@string/per_app_params_hint" />

        <!-- 常用命令速查 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/per_app_params_ref_258"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/per_app_params_ref_273"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/per_app_params_ref_267"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btn_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="@android:color/holo_blue_dark"
            android:text="@string/per_app_open_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/per_app_save" />

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/per_app_delete" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
